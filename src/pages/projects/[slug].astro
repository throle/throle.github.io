---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import RoleBoundary from '../../components/RoleBoundary.astro';
import ValidationCard from '../../components/ValidationCard.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
const p = project.data;
const toc = [
  ['summary', '项目概览'], ['context', '项目背景'], ['role', '我做的工作'], ['problem', '工程问题与目标'],
  ['inputs', '输入、试样或工况'], ['workflow', '技术路线'], ['methods', '核心方法'], ['validation', '验证与质量控制'],
  ['results', '主要结果'], ['deliverables', '形成的产物'], ['visual', '图件与图注'], ['evidence', '相关文章与链接'],
  ['capabilities', '可以带到新工作的经验'], ['questions', '可以继续聊的问题']
];
---

<BaseLayout title={`${p.title}｜项目｜李宗泽`} description={p.summary} canonicalPath={`/projects/${p.slug}/`}>
  <header class="project-detail-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a> / <a href="/projects/">项目</a> / {p.shortTitle}</nav>
      <div class="project-detail-grid">
        <div>
          <div class="tag-row"><span class="status">{p.projectType}</span><span class="tag">{p.status}</span></div>
          <h1 style="margin-top:18px">{p.title}</h1>
          <p class="lede">{p.summary}</p>
          <p><strong>我做的工作：</strong>{p.personalRole}</p>
        </div>
        <figure>
          <button class="visual-button" type="button" data-lightbox data-lightbox-title={p.shortTitle} aria-label={`放大查看${p.shortTitle}流程示意图`}>
            <ProjectVisual variant={p.visual} alt={p.visualCaption} />
            <figcaption>{p.visualCaption}</figcaption>
          </button>
        </figure>
      </div>
      <RoleBoundary personalRole={p.personalRole} collaborationBoundary={p.collaborationBoundary} />
    </div>
  </header>

  <div class="section">
    <div class="container article-shell">
      <article class="article-content">
        <section id="summary"><h2>项目概览</h2><p>{p.summary}</p></section>
        <section id="context"><h2>项目背景</h2><p><strong>{p.projectType}</strong> · {p.organizationPublic}。</p>{p.projectType === '横向项目' && <p class="micro">企业合作项目隐去了单位名称和具体数据。</p>}</section>
        <section id="role"><h2>我做的工作</h2><p>{p.personalRole}</p><h3>项目协作</h3><p>{p.collaborationBoundary}</p></section>
        <section id="problem"><h2>工程问题与目标</h2><p>{p.problem}</p><ul>{p.objectives.map((item) => <li>{item}</li>)}</ul></section>
        <section id="inputs"><h2>输入数据、试样或工况</h2><ul>{p.inputs.map((item) => <li>{item}</li>)}</ul></section>
        <section id="workflow"><h2>技术路线</h2><ol>{p.workflow.map((item) => <li>{item}</li>)}</ol></section>
        <section id="methods"><h2>核心方法</h2><div class="tag-row">{p.methods.map((item) => <span class="tag">{item}</span>)}</div><p style="margin-top:20px">研究对象包括：{p.objects.join('、')}。</p></section>
        <section id="validation"><h2>结果怎么检查</h2><ValidationCard validation={p.validation} limitations={p.limitations} /></section>
        <section id="results"><h2>主要结果</h2><ul>{p.results.map((item) => <li>{item}</li>)}</ul></section>
        <section id="deliverables"><h2>形成的产物</h2><ul>{p.deliverables.map((item) => <li>{item}</li>)}</ul></section>
        <section id="visual"><h2>图件与说明</h2><figure><button class="visual-button" type="button" data-lightbox data-lightbox-title={p.shortTitle} aria-label={`放大查看${p.shortTitle}流程示意图`}><ProjectVisual variant={p.visual} alt={p.visualCaption} /><figcaption>{p.visualCaption}</figcaption></button></figure></section>
        <section id="evidence"><h2>相关文章与链接</h2>{p.evidenceLinks.length ? <ul>{p.evidenceLinks.map((link) => <li><a href={link.url}>{link.label}</a> · {link.type}</li>)}</ul> : <p>与项目相关的已发表论文可以在<a href="/publications/">论文成果页</a>查看。</p>}</section>
        <section id="capabilities"><h2>这些经验可以用在哪里</h2><div class="tag-row">{p.transferableCapabilities.map((item) => <span class="tag">{item}</span>)}</div></section>
        <section id="questions"><h2>如果继续聊这个项目</h2><ol>{p.discussionQuestions.map((item) => <li>{item}</li>)}</ol><div class="button-row"><a class="button secondary" href="/projects/">返回全部项目</a><a class="button secondary" href="/capabilities/">查看能力与工具</a></div></section>
      </article>
      <aside class="toc" aria-label="页内目录"><strong>阅读目录</strong>{toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</aside>
    </div>
  </div>
</BaseLayout>
