---
const { personalRole, collaborationBoundary } = Astro.props;
---
<div class="role-boundary">
  <section class="boundary-card" aria-labelledby="personal-role-title">
    <h2 id="personal-role-title">本人参与</h2>
    <p>{personalRole}</p>
  </section>
  <section class="boundary-card team" aria-labelledby="team-boundary-title">
    <h2 id="team-boundary-title">团队与协作</h2>
    <p>{collaborationBoundary}</p>
  </section>
</div>
