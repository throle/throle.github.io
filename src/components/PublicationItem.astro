---
import type { CollectionEntry } from 'astro:content';
interface Props { publication: CollectionEntry<'publications'>; }
const { publication } = Astro.props;
const p = publication.data;
---

<article class="publication-item" data-publication data-status={p.status} data-position={p.personalAuthorPosition} data-categories={p.categories.join('|')}>
  <div class="publication-meta">
    <span class:list={['status', p.status === '在投' && 'warning']}>{p.status}</span>
    <span class="tag">{p.personalAuthorPosition}</span>
    <span class="micro mono">{p.year}</span>
  </div>
  <h3>{p.officialUrl ? <a href={p.officialUrl}>{p.title}</a> : p.title}</h3>
  <p class="authors">{p.authors.join('，')}</p>
  <p>{p.venue} · {p.abstractPublic}</p>
  {p.doi && <p class="micro mono">DOI：<a href={p.officialUrl}>{p.doi}</a></p>}
</article>
